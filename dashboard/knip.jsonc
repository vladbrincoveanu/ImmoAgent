{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // A symbol exported *and* consumed inside its own module is not dead code —
  // e.g. PaywallModal's `PaywallReason`, which types its own `reason` prop and
  // is exported so callers can construct that prop.
  "ignoreExportsUsedInFile": true,

  // Hand-invoked maintenance/data-gen tools. Never imported, so knip would
  // otherwise report them as unused files.
  //   build-districts-geojson.mjs -> regenerates public/vienna-districts.geojson
  //   audit-summary.mjs           -> formats `npm audit --json` for the security pass
  "entry": ["scripts/*.mjs"],

  "ignoreDependencies": [
    // Loaded by ts-jest to compile jest.config.ts (and to resolve the "@/*"
    // path alias in it). There is no import statement anywhere, so knip cannot
    // see the usage. Removing either breaks `npm test` immediately.
    "ts-node",
    "tsconfig-paths",

    // Only consumed by the parked dark-mode components ignored below. Kept so
    // the feature can be wired up without a reinstall; drop it together with
    // ThemeProvider/ThemeToggle if dark mode is abandoned.
    "next-themes"
  ],

  "ignore": [
    // PARKED FEATURES — deliberately unreferenced, kept for planned work.
    // Review these on the next cleanup pass; delete if still unwired.
    //   Dark mode (parked): ThemeProvider + ThemeToggle, backed by the
    //   next-themes dependency below. Not mounted in app/layout.tsx.
    "components/ThemeProvider.tsx",
    "components/ThemeToggle.tsx",
    //   Map detail panel (parked): superseded by the inline popup on
    //   /dashboard/map, retained for the planned side-panel layout.
    "components/ListingSidebar.tsx"
  ]
}
