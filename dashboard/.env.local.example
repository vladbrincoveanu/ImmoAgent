MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/immo
ADMIN_USER=admin
ADMIN_PASSWORD=password
# Shared secret that unlocks Pro features (alerts) at /alerts.
# Unset = unlock disabled; the endpoint fails closed with 503.
PRO_UNLOCK_PASSWORD=choose-a-long-random-passphrase
# Sentry custom integration client secret used to verify Seer webhooks.
# Configure the integration webhook URL as /api/webhooks/sentry/seer.
SENTRY_SEER_CLIENT_SECRET=choose-the-sentry-client-secret
